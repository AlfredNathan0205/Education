generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Block 001: infrastructure tables (health_check, outbox_event).
/// Block 002: identity & privacy skeleton (Domain 01 sub-modules 01a/01b/01c,
///            minimal student [Domain 02] and audit_event [Domain 20]).
/// Block 003: Curriculum Governance machinery. Question and assessment tables belong to later blocks.

/// Health-check table — proves DB connectivity.
model health_check {
  id         Int      @id @default(autoincrement())
  checked_at DateTime @default(now())
}

/// Transactional outbox — every domain writes events here inside its
/// ACID transaction; the outbox relay reads and publishes them.
model outbox_event {
  id             String   @id @default(uuid()) @db.Uuid
  aggregate_type String   @db.VarChar(255)
  aggregate_id   String   @db.VarChar(255)
  event_type     String   @db.VarChar(255)
  payload        Json
  created_at     DateTime @default(now())
  published_at   DateTime?
  /// Idempotency key — prevents duplicate processing downstream.
  idempotency_key String  @unique @db.VarChar(255)

  @@index([published_at])
  @@index([created_at])
}

// ════════════════════════════════════════════════════════════════════════
// CONSTRUCTION-002 — Identity & Privacy Skeleton
// Ownership per docs/decisions/D11_CONSENT_STATE_OWNERSHIP.md
// ════════════════════════════════════════════════════════════════════════

enum account_status {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum auth_identity_kind {
  EMAIL
  PHONE
}

enum student_access_kind {
  SELF
  GUARDIAN
  SCHOOL_ASSISTED
}

enum guardian_relationship_status {
  CLAIMED
  VERIFIED
  REVOKED
}

enum guardian_verification_status {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum jurisdiction_policy_status {
  DRAFT
  ACTIVE
  RETIRED
}

enum legal_review_status {
  UNREVIEWED
  COUNSEL_REVIEWED
}

enum consent_capacity {
  SELF
  GUARDIAN
}

// ── 01a Accounts & Sessions ─────────────────────────────────────────────

/// Login account. Separate from student identity and guardian relationship.
model account {
  id         String         @id @default(uuid()) @db.Uuid
  status     account_status @default(ACTIVE)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  identities              authentication_identity[]
  sessions                auth_session[]
  student_access          account_student_access[]
  guardian_relationships  guardian_relationship[]
  consent_records_granted consent_record[]
  consent_withdrawals     consent_withdrawal[]
  role_assignments        role_assignment[]         @relation("role_assignment_account")
  role_assignments_issued role_assignment[]         @relation("role_assignment_granter")
  audit_events            audit_event[]
}

/// One verified way to authenticate (email or phone). Passwordless.
model authentication_identity {
  id                    String             @id @default(uuid()) @db.Uuid
  account_id            String             @db.Uuid
  kind                  auth_identity_kind
  /// Lower-cased email, or E.164 phone. Normalized before storage.
  identifier_normalized String             @db.VarChar(320)
  verified_at           DateTime?
  created_at            DateTime           @default(now())

  account account @relation(fields: [account_id], references: [id])

  @@unique([kind, identifier_normalized])
  @@index([account_id])
}

/// One-time passcode challenge. Only a hash of the code is stored.
model otp_challenge {
  id                    String             @id @default(uuid()) @db.Uuid
  kind                  auth_identity_kind
  identifier_normalized String             @db.VarChar(320)
  code_hash             String             @db.VarChar(128)
  expires_at            DateTime
  attempts              Int                @default(0)
  max_attempts          Int                @default(5)
  consumed_at           DateTime?
  created_at            DateTime           @default(now())

  @@index([kind, identifier_normalized, created_at])
}

/// Server-side session. Only a hash of the bearer token is stored.
model auth_session {
  id           String    @id @default(uuid()) @db.Uuid
  account_id   String    @db.Uuid
  token_hash   String    @unique @db.VarChar(128)
  created_at   DateTime  @default(now())
  expires_at   DateTime
  revoked_at   DateTime?
  last_seen_at DateTime?

  account account @relation(fields: [account_id], references: [id])

  @@index([account_id])
}

// ── Domain 02 stub ──────────────────────────────────────────────────────

/// Minimal student identity. Domain 02 extends this in a later block.
/// Kept deliberately small: data minimization (name is C3 child personal data).
model student {
  id           String   @id @default(uuid()) @db.Uuid
  display_name String?  @db.VarChar(120)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  account_access         account_student_access[]
  guardian_relationships guardian_relationship[]
  age_classifications    age_classification[]
  consent_records        consent_record[]
}

/// Which login account may act for which student, and in what capacity.
model account_student_access {
  id          String              @id @default(uuid()) @db.Uuid
  account_id  String              @db.Uuid
  student_id  String              @db.Uuid
  access_kind student_access_kind
  granted_at  DateTime            @default(now())
  revoked_at  DateTime?

  account account @relation(fields: [account_id], references: [id])
  student student @relation(fields: [student_id], references: [id])

  @@unique([account_id, student_id, access_kind])
  @@index([student_id])
}

// ── 01b Privacy & Consent ───────────────────────────────────────────────

/// Versioned, jurisdiction-specific legal parameters. Thresholds and accepted
/// verification methods live here as DATA, never as constants in code.
/// A policy may only become ACTIVE once legal_review = COUNSEL_REVIEWED.
model jurisdiction_policy {
  id                     String                     @id @default(uuid()) @db.Uuid
  /// ISO 3166-1 alpha-2, e.g. "AE", "IN".
  jurisdiction_code      String                     @db.VarChar(8)
  version                Int
  status                 jurisdiction_policy_status @default(DRAFT)
  legal_review           legal_review_status        @default(UNREVIEWED)
  /// Pointer to the counsel opinion / memo, not its content.
  legal_review_reference String?                    @db.VarChar(255)
  effective_from         DateTime?
  /// Shape validated in code (JurisdictionPolicyConfig).
  config                 Json
  created_at             DateTime                   @default(now())

  age_classifications     age_classification[]
  guardian_verifications  guardian_verification[]
  consent_policy_versions consent_policy_version[]

  @@unique([jurisdiction_code, version])
}

/// Append-only. A DOB correction supersedes the row rather than editing it.
/// DOB is highly restricted data (C5): access is limited to this module.
model age_classification {
  id                        String    @id @default(uuid()) @db.Uuid
  student_id                String    @db.Uuid
  jurisdiction_policy_id    String?   @db.Uuid
  date_of_birth             DateTime  @db.Date
  is_minor                  Boolean
  requires_guardian_consent Boolean
  /// POLICY | FAIL_CLOSED_NO_ACTIVE_POLICY | FAIL_CLOSED_INCOMPLETE_POLICY
  basis                     String    @db.VarChar(64)
  /// How the DOB was established. Open string: the mandatory method is a legal
  /// question that is still open (see BLOCKER_01).
  dob_evidence_method       String    @db.VarChar(64)
  classified_at             DateTime  @default(now())
  superseded_at             DateTime?

  student             student              @relation(fields: [student_id], references: [id])
  jurisdiction_policy jurisdiction_policy? @relation(fields: [jurisdiction_policy_id], references: [id])

  @@index([student_id, superseded_at])
}

/// Guardian-to-student link. Distinct from the guardian's login account.
model guardian_relationship {
  id                  String                       @id @default(uuid()) @db.Uuid
  guardian_account_id String                       @db.Uuid
  student_id          String                       @db.Uuid
  relationship_type   String                       @db.VarChar(50)
  status              guardian_relationship_status @default(CLAIMED)
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt

  guardian_account account                 @relation(fields: [guardian_account_id], references: [id])
  student          student                 @relation(fields: [student_id], references: [id])
  verifications    guardian_verification[]
  authorities      guardian_authority[]

  @@unique([guardian_account_id, student_id])
  @@index([student_id])
}

/// Evidence that a claimed guardian relationship is real. The method is data.
model guardian_verification {
  id                       String                       @id @default(uuid()) @db.Uuid
  guardian_relationship_id String                       @db.Uuid
  method                   String                       @db.VarChar(64)
  status                   guardian_verification_status @default(PENDING)
  /// Opaque pointer to evidence held elsewhere; never the evidence itself.
  evidence_reference       String?                      @db.VarChar(255)
  jurisdiction_policy_id   String?                      @db.Uuid
  verified_at              DateTime?
  expires_at               DateTime?
  created_at               DateTime                     @default(now())

  guardian_relationship guardian_relationship @relation(fields: [guardian_relationship_id], references: [id])
  jurisdiction_policy   jurisdiction_policy?  @relation(fields: [jurisdiction_policy_id], references: [id])
  authorities           guardian_authority[]

  @@index([guardian_relationship_id])
}

/// What a verified guardian may do (e.g. give consent). Born from a verification.
model guardian_authority {
  id                       String    @id @default(uuid()) @db.Uuid
  guardian_relationship_id String    @db.Uuid
  guardian_verification_id String    @db.Uuid
  authority_type           String    @db.VarChar(64)
  granted_at               DateTime  @default(now())
  revoked_at               DateTime?

  guardian_relationship guardian_relationship @relation(fields: [guardian_relationship_id], references: [id])
  guardian_verification guardian_verification @relation(fields: [guardian_verification_id], references: [id])
  consent_records       consent_record[]

  @@index([guardian_relationship_id])
}

/// A reason personal data is processed (e.g. core assessment, analytics).
model consent_purpose {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  description String   @db.VarChar(500)
  created_at  DateTime @default(now())

  policy_versions consent_policy_version[]
  records         consent_record[]
}

/// Versioned consent wording for a purpose. A grant references the exact version.
model consent_policy_version {
  id                     String    @id @default(uuid()) @db.Uuid
  consent_purpose_id     String    @db.Uuid
  version                Int
  jurisdiction_policy_id String?   @db.Uuid
  /// Pointer to the versioned consent text, not the text itself.
  text_reference         String    @db.VarChar(255)
  effective_from         DateTime
  retired_at             DateTime?

  consent_purpose     consent_purpose      @relation(fields: [consent_purpose_id], references: [id])
  jurisdiction_policy jurisdiction_policy? @relation(fields: [jurisdiction_policy_id], references: [id])
  records             consent_record[]

  @@unique([consent_purpose_id, version])
}

/// Append-only grant. Active consent is DERIVED (grant minus withdrawal), never edited.
model consent_record {
  id                      String           @id @default(uuid()) @db.Uuid
  student_id              String           @db.Uuid
  consent_purpose_id      String           @db.Uuid
  consent_policy_version_id String         @db.Uuid
  granted_by_account_id   String           @db.Uuid
  capacity                consent_capacity
  /// Required when capacity = GUARDIAN.
  guardian_authority_id   String?          @db.Uuid
  granted_at              DateTime         @default(now())

  student        student                @relation(fields: [student_id], references: [id])
  purpose        consent_purpose        @relation(fields: [consent_purpose_id], references: [id])
  policy_version consent_policy_version @relation(fields: [consent_policy_version_id], references: [id])
  granted_by     account                @relation(fields: [granted_by_account_id], references: [id])
  authority      guardian_authority?    @relation(fields: [guardian_authority_id], references: [id])
  withdrawal     consent_withdrawal?

  @@index([student_id, consent_purpose_id])
}

/// Withdrawal of one grant. Withdrawal disables the affected processing.
model consent_withdrawal {
  id                    String   @id @default(uuid()) @db.Uuid
  consent_record_id     String   @unique @db.Uuid
  withdrawn_by_account_id String @db.Uuid
  withdrawn_at          DateTime @default(now())
  reason_code           String?  @db.VarChar(64)

  consent_record consent_record @relation(fields: [consent_record_id], references: [id])
  withdrawn_by   account        @relation(fields: [withdrawn_by_account_id], references: [id])
}

// ── 01c Authorization skeleton (tables only; evaluation logic comes later) ─

model role {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(64)
  description String @db.VarChar(500)

  permissions role_permission[]
  assignments role_assignment[]
}

model permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(64)
  description String @db.VarChar(500)

  roles role_permission[]
}

model role_permission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       role       @relation(fields: [role_id], references: [id])
  permission permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
}

model resource_scope {
  id         String @id @default(uuid()) @db.Uuid
  scope_type String @db.VarChar(64)
  scope_ref  String @db.VarChar(255)

  assignments role_assignment[]

  @@unique([scope_type, scope_ref])
}

model role_assignment {
  id                    String    @id @default(uuid()) @db.Uuid
  account_id            String    @db.Uuid
  role_id               String    @db.Uuid
  resource_scope_id     String?   @db.Uuid
  granted_by_account_id String?   @db.Uuid
  granted_at            DateTime  @default(now())
  revoked_at            DateTime?

  account    account         @relation("role_assignment_account", fields: [account_id], references: [id])
  role       role            @relation(fields: [role_id], references: [id])
  scope      resource_scope? @relation(fields: [resource_scope_id], references: [id])
  granted_by account?        @relation("role_assignment_granter", fields: [granted_by_account_id], references: [id])

  @@index([account_id])
}

// ── Domain 20 stub ──────────────────────────────────────────────────────

/// Append-only audit trail. Domain 20 extends this later; Block 002 only appends.
model audit_event {
  id               String   @id @default(uuid()) @db.Uuid
  actor_account_id String?  @db.Uuid
  action           String   @db.VarChar(128)
  subject_type     String   @db.VarChar(64)
  subject_id       String   @db.VarChar(255)
  reason_code      String?  @db.VarChar(64)
  metadata         Json?
  occurred_at      DateTime @default(now())

  actor account? @relation(fields: [actor_account_id], references: [id])

  @@index([subject_type, subject_id])
  @@index([occurred_at])
}

// ---------------------------------------------------------------------------
// Block 003 — Curriculum Governance (Domain 03 machinery; Build Sequence step 4).
// Machinery only: no syllabus content is seeded. Actor ids are stored without a
// foreign key to account (curriculum governance must not depend on 01a rows).
// ---------------------------------------------------------------------------

enum curriculum_state {
  DISCOVERED
  EVIDENCE_COLLECTION
  DRAFT
  AI_STRUCTURED
  VALIDATION_PENDING
  VALIDATED
  ADMIN_REVIEW
  CHANGES_REQUIRED
  APPROVED
  ACTIVE
  ACTIVE_WITH_REVIEW
  SUSPENDED
  BLOCKED
  REJECTED
  SUPERSEDED
  ARCHIVED
  WITHDRAWN
}

enum curriculum_provenance {
  OFFICIAL_EXPLICIT
  OFFICIAL_INFERRED
  SYSTEM_DERIVED
  ADMIN_ADDED
}

enum evidence_pack_status {
  DRAFT
  VERIFIED
}

enum validation_severity {
  ERROR
  WARNING
}

enum validation_run_status {
  PASSED
  FAILED
}

/// e.g. code "ICSE". Reference data.
model curriculum {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(32)
  name       String   @db.VarChar(255)
  created_at DateTime @default(now())

  versions curriculum_version[]
}

/// e.g. label "2026-27".
model curriculum_version {
  id            String   @id @default(uuid()) @db.Uuid
  curriculum_id String   @db.Uuid
  label         String   @db.VarChar(32)
  created_at    DateTime @default(now())

  curriculum       curriculum                   @relation(fields: [curriculum_id], references: [id])
  subject_versions curriculum_subject_version[]

  @@unique([curriculum_id, label])
}

model grade {
  id         String @id @default(uuid()) @db.Uuid
  code       String @unique @db.VarChar(16)
  sort_order Int

  subject_versions curriculum_subject_version[]
}

model subject {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(32)
  name String @db.VarChar(128)

  subject_versions curriculum_subject_version[]
}

/// The approval unit: Curriculum + Version + Grade + Subject. A correction after
/// activation is a NEW revision row; an activated row is never edited.
model curriculum_subject_version {
  id                    String           @id @default(uuid()) @db.Uuid
  curriculum_version_id String           @db.Uuid
  grade_id              String           @db.Uuid
  subject_id            String           @db.Uuid
  revision              Int
  state                 curriculum_state @default(DRAFT)
  supersedes_id         String?          @db.Uuid
  last_edited_by        String?          @db.Uuid
  activated_at          DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  curriculum_version curriculum_version @relation(fields: [curriculum_version_id], references: [id])
  grade              grade              @relation(fields: [grade_id], references: [id])
  subject            subject            @relation(fields: [subject_id], references: [id])
  supersedes         curriculum_subject_version?  @relation("revision_chain", fields: [supersedes_id], references: [id])
  superseded_by      curriculum_subject_version[] @relation("revision_chain")

  chapters         chapter[]
  evidence_packs   curriculum_evidence_pack[]
  validation_runs  curriculum_validation_run[]
  approvals        curriculum_approval_record[]
  activations      curriculum_activation_record[]
  events           curriculum_event_log[]

  @@unique([curriculum_version_id, grade_id, subject_id, revision])
  @@index([state])
}

model curriculum_evidence_pack {
  id                 String               @id @default(uuid()) @db.Uuid
  subject_version_id String               @db.Uuid
  status             evidence_pack_status @default(DRAFT)
  /// Who verified it and a pointer to their verification note.
  verified_by        String?              @db.Uuid
  verification_note  String?              @db.VarChar(1000)
  verified_at        DateTime?
  created_at         DateTime             @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])
  references      curriculum_evidence_reference[]

  @@index([subject_version_id])
}

/// A pointer to an official source. Content of the source is not stored here.
model curriculum_evidence_reference {
  id           String    @id @default(uuid()) @db.Uuid
  pack_id      String    @db.Uuid
  source_title String    @db.VarChar(500)
  source_url   String?   @db.VarChar(2000)
  /// Where in the source: page, section, clause.
  locator      String?   @db.VarChar(255)
  retrieved_at DateTime?
  created_at   DateTime  @default(now())

  pack curriculum_evidence_pack @relation(fields: [pack_id], references: [id])

  @@index([pack_id])
}

model chapter {
  id                   String                @id @default(uuid()) @db.Uuid
  subject_version_id   String                @db.Uuid
  code                 String                @db.VarChar(64)
  title                String                @db.VarChar(500)
  position             Int
  provenance           curriculum_provenance
  evidence_reference_id String?              @db.Uuid
  rationale            String?               @db.VarChar(1000)

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id], onDelete: Cascade)
  topics          topic[]

  @@unique([subject_version_id, code])
}

model topic {
  id                    String                @id @default(uuid()) @db.Uuid
  chapter_id            String                @db.Uuid
  code                  String                @db.VarChar(64)
  title                 String                @db.VarChar(500)
  position              Int
  provenance            curriculum_provenance
  evidence_reference_id String?               @db.Uuid
  rationale             String?               @db.VarChar(1000)

  chapter        chapter         @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  micro_concepts micro_concept[]

  @@unique([chapter_id, code])
}

model micro_concept {
  id                    String                @id @default(uuid()) @db.Uuid
  topic_id              String                @db.Uuid
  code                  String                @db.VarChar(64)
  title                 String                @db.VarChar(500)
  position              Int
  provenance            curriculum_provenance
  evidence_reference_id String?               @db.Uuid
  rationale             String?               @db.VarChar(1000)

  topic              topic                @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  learning_objectives learning_objective[]

  @@unique([topic_id, code])
}

model learning_objective {
  id                    String                @id @default(uuid()) @db.Uuid
  micro_concept_id      String                @db.Uuid
  code                  String                @db.VarChar(64)
  statement             String                @db.VarChar(1000)
  position              Int
  provenance            curriculum_provenance
  evidence_reference_id String?               @db.Uuid
  rationale             String?               @db.VarChar(1000)

  micro_concept micro_concept @relation(fields: [micro_concept_id], references: [id], onDelete: Cascade)

  @@unique([micro_concept_id, code])
}

/// Automated validation precedes human review. Results are append-only.
model curriculum_validation_run {
  id                 String                @id @default(uuid()) @db.Uuid
  subject_version_id String                @db.Uuid
  status             validation_run_status
  error_count        Int
  warning_count      Int
  created_at         DateTime              @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])
  results         curriculum_validation_result[]

  @@index([subject_version_id])
}

model curriculum_validation_result {
  id       String              @id @default(uuid()) @db.Uuid
  run_id   String              @db.Uuid
  severity validation_severity
  rule     String              @db.VarChar(64)
  path     String              @db.VarChar(500)
  message  String              @db.VarChar(1000)

  run curriculum_validation_run @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id])
}

model curriculum_approval_record {
  id                 String   @id @default(uuid()) @db.Uuid
  subject_version_id String   @db.Uuid
  decision           String   @db.VarChar(16)
  actor_account_id   String   @db.Uuid
  note               String?  @db.VarChar(1000)
  decided_at         DateTime @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])

  @@index([subject_version_id])
}

/// APPROVED is not ACTIVE: activation is its own human act, recorded here.
model curriculum_activation_record {
  id                 String   @id @default(uuid()) @db.Uuid
  subject_version_id String   @db.Uuid
  actor_account_id   String   @db.Uuid
  activated_at       DateTime @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])

  @@index([subject_version_id])
}

/// Append-only history of every transition and content replacement.
model curriculum_event_log {
  id                 String           @id @default(uuid()) @db.Uuid
  subject_version_id String           @db.Uuid
  event_type         String           @db.VarChar(64)
  from_state         curriculum_state?
  to_state           curriculum_state?
  actor_kind         String           @db.VarChar(16)
  actor_account_id   String?          @db.Uuid
  note               String?          @db.VarChar(1000)
  occurred_at        DateTime         @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])

  @@index([subject_version_id, occurred_at])
}

// ---------------------------------------------------------------------------
// Block 008 — Question bank (multiple choice). A question belongs to a curriculum UNIT
// (curriculum version + grade + subject), not to one revision of it, and points at a learning
// objective by its codes ("chapter/topic/concept/objective"). A new curriculum revision is a new
// set of rows, so a foreign key to learning_objective would break on every correction.
// A question's wording is a REVISION; an approved revision is never edited.
// ---------------------------------------------------------------------------

enum question_state {
  DRAFT
  IN_REVIEW
  CHANGES_REQUIRED
  APPROVED
  RETIRED
  SUPERSEDED
}

enum question_difficulty {
  EASY
  MEDIUM
  HARD
}

enum question_origin {
  HUMAN
  AI_DRAFT
}

model question {
  id                    String   @id @default(uuid()) @db.Uuid
  curriculum_version_id String   @db.Uuid
  grade_id              String   @db.Uuid
  subject_id            String   @db.Uuid
  /// Unique within the unit, chosen by the author so a corrected file can update the same question.
  code                  String   @db.VarChar(64)
  /// "chapter_code/topic_code/concept_code/objective_code" in the unit's curriculum.
  objective_path        String   @db.VarChar(300)
  created_at            DateTime @default(now())

  revisions question_revision[]

  @@unique([curriculum_version_id, grade_id, subject_id, code])
  @@index([curriculum_version_id, grade_id, subject_id])
}

model question_revision {
  id            String              @id @default(uuid()) @db.Uuid
  question_id   String              @db.Uuid
  revision      Int
  state         question_state      @default(DRAFT)
  origin        question_origin
  stem          String              @db.VarChar(2000)
  explanation   String?             @db.VarChar(2000)
  difficulty    question_difficulty
  /// SHA-256 of the normalised stem, to refuse the same question twice in a unit.
  stem_hash     String              @db.VarChar(64)
  /// Account ids are stored without a foreign key, as in curriculum governance. Null for the AI.
  authored_by   String?             @db.Uuid
  /// Everyone who wrote or edited the wording. None of them, nor the submitter, may approve it.
  contributor_ids String[]          @db.Uuid
  submitted_by  String?             @db.Uuid
  reviewed_by   String?             @db.Uuid
  review_note   String?             @db.VarChar(1000)
  /// The approver confirmed they checked the answer key themselves.
  answer_verified Boolean           @default(false)
  /// For AI drafts: who ran the import and the file hash.
  ai_source     String?             @db.VarChar(255)
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt

  question question          @relation(fields: [question_id], references: [id])
  options  question_option[]
  events   question_event[]

  @@unique([question_id, revision])
  @@index([state])
  @@index([stem_hash])
}

model question_option {
  id          String  @id @default(uuid()) @db.Uuid
  revision_id String  @db.Uuid
  position    Int
  text        String  @db.VarChar(500)
  is_correct  Boolean

  revision question_revision @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@unique([revision_id, position])
}

/// Append-only history of a revision's state changes.
model question_event {
  id          String          @id @default(uuid()) @db.Uuid
  revision_id String          @db.Uuid
  from_state  question_state?
  to_state    question_state
  actor_kind  String          @db.VarChar(16)
  actor_account_id String?    @db.Uuid
  note        String?         @db.VarChar(1000)
  occurred_at DateTime        @default(now())

  revision question_revision @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@index([revision_id])
}
