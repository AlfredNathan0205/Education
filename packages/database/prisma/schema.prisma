generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Block 001: infrastructure tables (health_check, outbox_event).
/// Block 002: identity & privacy skeleton (Domain 01 sub-modules 01a/01b/01c,
///            minimal student [Domain 02] and audit_event [Domain 20]).
/// Block 003: Curriculum Governance machinery. Question and assessment tables belong to later blocks.

/// Health-check table — proves DB connectivity.
model health_check {
  id         Int      @id @default(autoincrement())
  checked_at DateTime @default(now())
}

/// Transactional outbox — every domain writes events here inside its
/// ACID transaction; the outbox relay reads and publishes them.
model outbox_event {
  id             String   @id @default(uuid()) @db.Uuid
  aggregate_type String   @db.VarChar(255)
  aggregate_id   String   @db.VarChar(255)
  event_type     String   @db.VarChar(255)
  payload        Json
  created_at     DateTime @default(now())
  published_at   DateTime?
  /// Idempotency key — prevents duplicate processing downstream.
  idempotency_key String  @unique @db.VarChar(255)

  @@index([published_at])
  @@index([created_at])
}

// ════════════════════════════════════════════════════════════════════════
// CONSTRUCTION-002 — Identity & Privacy Skeleton
// Ownership per docs/decisions/D11_CONSENT_STATE_OWNERSHIP.md
// ════════════════════════════════════════════════════════════════════════

enum account_status {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum auth_identity_kind {
  EMAIL
  PHONE
}

enum student_access_kind {
  SELF
  GUARDIAN
  SCHOOL_ASSISTED
}

enum guardian_relationship_status {
  CLAIMED
  VERIFIED
  REVOKED
}

enum guardian_verification_status {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum jurisdiction_policy_status {
  DRAFT
  ACTIVE
  RETIRED
}

enum legal_review_status {
  UNREVIEWED
  COUNSEL_REVIEWED
}

enum consent_capacity {
  SELF
  GUARDIAN
}

// ── 01a Accounts & Sessions ─────────────────────────────────────────────

/// Login account. Separate from student identity and guardian relationship.
model account {
  id         String         @id @default(uuid()) @db.Uuid
  status     account_status @default(ACTIVE)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  identities              authentication_identity[]
  sessions                auth_session[]
  student_access          account_student_access[]
  guardian_relationships  guardian_relationship[]
  consent_records_granted consent_record[]
  consent_withdrawals     consent_withdrawal[]
  role_assignments        role_assignment[]         @relation("role_assignment_account")
  role_assignments_issued role_assignment[]         @relation("role_assignment_granter")
  audit_events            audit_event[]
}

/// One verified way to authenticate (email or phone). Passwordless.
model authentication_identity {
  id                    String             @id @default(uuid()) @db.Uuid
  account_id            String             @db.Uuid
  kind                  auth_identity_kind
  /// Lower-cased email, or E.164 phone. Normalized before storage.
  identifier_normalized String             @db.VarChar(320)
  verified_at           DateTime?
  created_at            DateTime           @default(now())

  account account @relation(fields: [account_id], references: [id])

  @@unique([kind, identifier_normalized])
  @@index([account_id])
}

/// One-time passcode challenge. Only a hash of the code is stored.
model otp_challenge {
  id                    String             @id @default(uuid()) @db.Uuid
  kind                  auth_identity_kind
  identifier_normalized String             @db.VarChar(320)
  code_hash             String             @db.VarChar(128)
  expires_at            DateTime
  attempts              Int                @default(0)
  max_attempts          Int                @default(5)
  consumed_at           DateTime?
  created_at            DateTime           @default(now())

  @@index([kind, identifier_normalized, created_at])
}

/// Server-side session. Only a hash of the bearer token is stored.
model auth_session {
  id           String    @id @default(uuid()) @db.Uuid
  account_id   String    @db.Uuid
  token_hash   String    @unique @db.VarChar(128)
  created_at   DateTime  @default(now())
  expires_at   DateTime
  revoked_at   DateTime?
  last_seen_at DateTime?

  account account @relation(fields: [account_id], references: [id])

  @@index([account_id])
}

// ── Domain 02 stub ──────────────────────────────────────────────────────

/// Minimal student identity. Domain 02 extends this in a later block.
/// Kept deliberately small: data minimization (name is C3 child personal data).
model student {
  id           String   @id @default(uuid()) @db.Uuid
  display_name String?  @db.VarChar(120)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  account_access         account_student_access[]
  guardian_relationships guardian_relationship[]
  age_classifications    age_classification[]
  consent_records        consent_record[]
  assessment_instances   assessment_instance[]
  question_exposures     student_question_exposure[]
  guardian_invitations   guardian_invitation[]
  school_associations    student_school_association[]
  academic_context       student_academic_context?
  chapter_selections     student_chapter_selection[]
}

/// Which login account may act for which student, and in what capacity.
model account_student_access {
  id          String              @id @default(uuid()) @db.Uuid
  account_id  String              @db.Uuid
  student_id  String              @db.Uuid
  access_kind student_access_kind
  granted_at  DateTime            @default(now())
  revoked_at  DateTime?

  account account @relation(fields: [account_id], references: [id])
  student student @relation(fields: [student_id], references: [id])

  @@unique([account_id, student_id, access_kind])
  @@index([student_id])
}

// ── 01b Privacy & Consent ───────────────────────────────────────────────

/// Versioned, jurisdiction-specific legal parameters. Thresholds and accepted
/// verification methods live here as DATA, never as constants in code.
/// A policy may only become ACTIVE once legal_review = COUNSEL_REVIEWED.
model jurisdiction_policy {
  id                     String                     @id @default(uuid()) @db.Uuid
  /// ISO 3166-1 alpha-2, e.g. "AE", "IN".
  jurisdiction_code      String                     @db.VarChar(8)
  version                Int
  status                 jurisdiction_policy_status @default(DRAFT)
  legal_review           legal_review_status        @default(UNREVIEWED)
  /// Pointer to the counsel opinion / memo, not its content.
  legal_review_reference String?                    @db.VarChar(255)
  effective_from         DateTime?
  /// Shape validated in code (JurisdictionPolicyConfig).
  config                 Json
  created_at             DateTime                   @default(now())

  age_classifications     age_classification[]
  guardian_verifications  guardian_verification[]
  consent_policy_versions consent_policy_version[]

  @@unique([jurisdiction_code, version])
}

/// Append-only. A DOB correction supersedes the row rather than editing it.
/// DOB is highly restricted data (C5): access is limited to this module.
model age_classification {
  id                        String    @id @default(uuid()) @db.Uuid
  student_id                String    @db.Uuid
  jurisdiction_policy_id    String?   @db.Uuid
  date_of_birth             DateTime  @db.Date
  is_minor                  Boolean
  requires_guardian_consent Boolean
  /// POLICY | FAIL_CLOSED_NO_ACTIVE_POLICY | FAIL_CLOSED_INCOMPLETE_POLICY
  basis                     String    @db.VarChar(64)
  /// How the DOB was established. Open string: the mandatory method is a legal
  /// question that is still open (see BLOCKER_01).
  dob_evidence_method       String    @db.VarChar(64)
  classified_at             DateTime  @default(now())
  superseded_at             DateTime?

  student             student              @relation(fields: [student_id], references: [id])
  jurisdiction_policy jurisdiction_policy? @relation(fields: [jurisdiction_policy_id], references: [id])

  @@index([student_id, superseded_at])
}

/// Guardian-to-student link. Distinct from the guardian's login account.
model guardian_relationship {
  id                  String                       @id @default(uuid()) @db.Uuid
  guardian_account_id String                       @db.Uuid
  student_id          String                       @db.Uuid
  relationship_type   String                       @db.VarChar(50)
  status              guardian_relationship_status @default(CLAIMED)
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt

  guardian_account account                 @relation(fields: [guardian_account_id], references: [id])
  student          student                 @relation(fields: [student_id], references: [id])
  verifications    guardian_verification[]
  authorities      guardian_authority[]

  @@unique([guardian_account_id, student_id])
  @@index([student_id])
}

/// Evidence that a claimed guardian relationship is real. The method is data.
model guardian_verification {
  id                       String                       @id @default(uuid()) @db.Uuid
  guardian_relationship_id String                       @db.Uuid
  method                   String                       @db.VarChar(64)
  status                   guardian_verification_status @default(PENDING)
  /// Opaque pointer to evidence held elsewhere; never the evidence itself.
  evidence_reference       String?                      @db.VarChar(255)
  jurisdiction_policy_id   String?                      @db.Uuid
  verified_at              DateTime?
  expires_at               DateTime?
  created_at               DateTime                     @default(now())

  guardian_relationship guardian_relationship @relation(fields: [guardian_relationship_id], references: [id])
  jurisdiction_policy   jurisdiction_policy?  @relation(fields: [jurisdiction_policy_id], references: [id])
  authorities           guardian_authority[]

  @@index([guardian_relationship_id])
}

/// What a verified guardian may do (e.g. give consent). Born from a verification.
model guardian_authority {
  id                       String    @id @default(uuid()) @db.Uuid
  guardian_relationship_id String    @db.Uuid
  guardian_verification_id String    @db.Uuid
  authority_type           String    @db.VarChar(64)
  granted_at               DateTime  @default(now())
  revoked_at               DateTime?

  guardian_relationship guardian_relationship @relation(fields: [guardian_relationship_id], references: [id])
  guardian_verification guardian_verification @relation(fields: [guardian_verification_id], references: [id])
  consent_records       consent_record[]

  @@index([guardian_relationship_id])
}

/// A reason personal data is processed (e.g. core assessment, analytics).
model consent_purpose {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  description String   @db.VarChar(500)
  created_at  DateTime @default(now())

  policy_versions consent_policy_version[]
  records         consent_record[]
}

/// Versioned consent wording for a purpose. A grant references the exact version.
model consent_policy_version {
  id                     String    @id @default(uuid()) @db.Uuid
  consent_purpose_id     String    @db.Uuid
  version                Int
  jurisdiction_policy_id String?   @db.Uuid
  /// Pointer to the versioned consent text, not the text itself.
  text_reference         String    @db.VarChar(255)
  effective_from         DateTime
  retired_at             DateTime?

  consent_purpose     consent_purpose      @relation(fields: [consent_purpose_id], references: [id])
  jurisdiction_policy jurisdiction_policy? @relation(fields: [jurisdiction_policy_id], references: [id])
  records             consent_record[]

  @@unique([consent_purpose_id, version])
}

/// Append-only grant. Active consent is DERIVED (grant minus withdrawal), never edited.
model consent_record {
  id                      String           @id @default(uuid()) @db.Uuid
  student_id              String           @db.Uuid
  consent_purpose_id      String           @db.Uuid
  consent_policy_version_id String         @db.Uuid
  granted_by_account_id   String           @db.Uuid
  capacity                consent_capacity
  /// Required when capacity = GUARDIAN.
  guardian_authority_id   String?          @db.Uuid
  granted_at              DateTime         @default(now())

  student        student                @relation(fields: [student_id], references: [id])
  purpose        consent_purpose        @relation(fields: [consent_purpose_id], references: [id])
  policy_version consent_policy_version @relation(fields: [consent_policy_version_id], references: [id])
  granted_by     account                @relation(fields: [granted_by_account_id], references: [id])
  authority      guardian_authority?    @relation(fields: [guardian_authority_id], references: [id])
  withdrawal     consent_withdrawal?

  @@index([student_id, consent_purpose_id])
}

/// Withdrawal of one grant. Withdrawal disables the affected processing.
model consent_withdrawal {
  id                    String   @id @default(uuid()) @db.Uuid
  consent_record_id     String   @unique @db.Uuid
  withdrawn_by_account_id String @db.Uuid
  withdrawn_at          DateTime @default(now())
  reason_code           String?  @db.VarChar(64)

  consent_record consent_record @relation(fields: [consent_record_id], references: [id])
  withdrawn_by   account        @relation(fields: [withdrawn_by_account_id], references: [id])
}

// ── 01c Authorization skeleton (tables only; evaluation logic comes later) ─

model role {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(64)
  description String @db.VarChar(500)

  permissions role_permission[]
  assignments role_assignment[]
}

model permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(64)
  description String @db.VarChar(500)

  roles role_permission[]
}

model role_permission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       role       @relation(fields: [role_id], references: [id])
  permission permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
}

model resource_scope {
  id         String @id @default(uuid()) @db.Uuid
  scope_type String @db.VarChar(64)
  scope_ref  String @db.VarChar(255)

  assignments role_assignment[]

  @@unique([scope_type, scope_ref])
}

model role_assignment {
  id                    String    @id @default(uuid()) @db.Uuid
  account_id            String    @db.Uuid
  role_id               String    @db.Uuid
  resource_scope_id     String?   @db.Uuid
  granted_by_account_id String?   @db.Uuid
  granted_at            DateTime  @default(now())
  revoked_at            DateTime?

  account    account         @relation("role_assignment_account", fields: [account_id], references: [id])
  role       role            @relation(fields: [role_id], references: [id])
  scope      resource_scope? @relation(fields: [resource_scope_id], references: [id])
  granted_by account?        @relation("role_assignment_granter", fields: [granted_by_account_id], references: [id])

  @@index([account_id])
}

// ── Domain 20 stub ──────────────────────────────────────────────────────

/// Append-only audit trail. Domain 20 extends this later; Block 002 only appends.
model audit_event {
  id               String   @id @default(uuid()) @db.Uuid
  actor_account_id String?  @db.Uuid
  action           String   @db.VarChar(128)
  subject_type     String   @db.VarChar(64)
  subject_id       String   @db.VarChar(255)
  reason_code      String?  @db.VarChar(64)
  metadata         Json?
  occurred_at      DateTime @default(now())

  actor account? @relation(fields: [actor_account_id], references: [id])

  @@index([subject_type, subject_id])
  @@index([occurred_at])
}

// ---------------------------------------------------------------------------
// Block 003 — Curriculum Governance (Domain 03 machinery; Build Sequence step 4).
// Machinery only: no syllabus content is seeded. Actor ids are stored without a
// foreign key to account (curriculum governance must not depend on 01a rows).
// ---------------------------------------------------------------------------

enum curriculum_state {
  DISCOVERED
  EVIDENCE_COLLECTION
  DRAFT
  AI_STRUCTURED
  VALIDATION_PENDING
  VALIDATED
  ADMIN_REVIEW
  CHANGES_REQUIRED
  APPROVED
  ACTIVE
  ACTIVE_WITH_REVIEW
  SUSPENDED
  BLOCKED
  REJECTED
  SUPERSEDED
  ARCHIVED
  WITHDRAWN
}

enum curriculum_provenance {
  OFFICIAL_EXPLICIT
  OFFICIAL_INFERRED
  SYSTEM_DERIVED
  ADMIN_ADDED
}

enum evidence_pack_status {
  DRAFT
  VERIFIED
}

enum validation_severity {
  ERROR
  WARNING
}

enum validation_run_status {
  PASSED
  FAILED
}

/// e.g. code "ICSE". Reference data.
model curriculum {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(32)
  name       String   @db.VarChar(255)
  created_at DateTime @default(now())

  versions curriculum_version[]
}

/// e.g. label "2026-27".
model curriculum_version {
  id            String   @id @default(uuid()) @db.Uuid
  curriculum_id String   @db.Uuid
  label         String   @db.VarChar(32)
  created_at    DateTime @default(now())

  curriculum       curriculum                   @relation(fields: [curriculum_id], references: [id])
  subject_versions curriculum_subject_version[]

  @@unique([curriculum_id, label])
}

model grade {
  id         String @id @default(uuid()) @db.Uuid
  code       String @unique @db.VarChar(16)
  sort_order Int

  subject_versions curriculum_subject_version[]
}

model subject {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(32)
  name String @db.VarChar(128)

  subject_versions curriculum_subject_version[]
}

/// The approval unit: Curriculum + Version + Grade + Subject. A correction after
/// activation is a NEW revision row; an activated row is never edited.
model curriculum_subject_version {
  id                    String           @id @default(uuid()) @db.Uuid
  curriculum_version_id String           @db.Uuid
  grade_id              String           @db.Uuid
  subject_id            String           @db.Uuid
  revision              Int
  state                 curriculum_state @default(DRAFT)
  supersedes_id         String?          @db.Uuid
  last_edited_by        String?          @db.Uuid
  activated_at          DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  curriculum_version curriculum_version @relation(fields: [curriculum_version_id], references: [id])
  grade              grade              @relation(fields: [grade_id], references: [id])
  subject            subject            @relation(fields: [subject_id], references: [id])
  supersedes         curriculum_subject_version?  @relation("revision_chain", fields: [supersedes_id], references: [id])
  superseded_by      curriculum_subject_version[] @relation("revision_chain")

  chapters         chapter[]
  evidence_packs   curriculum_evidence_pack[]
  validation_runs  curriculum_validation_run[]
  approvals        curriculum_approval_record[]
  activations      curriculum_activation_record[]
  events           curriculum_event_log[]

  @@unique([curriculum_version_id, grade_id, subject_id, revision])
  @@index([state])
}

model curriculum_evidence_pack {
  id                 String               @id @default(uuid()) @db.Uuid
  subject_version_id String               @db.Uuid
  status             evidence_pack_status @default(DRAFT)
  /// Who verified it and a pointer to their verification note.
  verified_by        String?              @db.Uuid
  verification_note  String?              @db.VarChar(1000)
  verified_at        DateTime?
  created_at         DateTime             @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])
  references      curriculum_evidence_reference[]

  @@index([subject_version_id])
}

/// A pointer to an official source. Content of the source is not stored here.
model curriculum_evidence_reference {
  id           String    @id @default(uuid()) @db.Uuid
  pack_id      String    @db.Uuid
  source_title String    @db.VarChar(500)
  source_url   String?   @db.VarChar(2000)
  /// Where in the source: page, section, clause.
  locator      String?   @db.VarChar(255)
  retrieved_at DateTime?
  created_at   DateTime  @default(now())

  pack curriculum_evidence_pack @relation(fields: [pack_id], references: [id])

  @@index([pack_id])
}

model chapter {
  id                   String                @id @default(uuid()) @db.Uuid
  subject_version_id   String                @db.Uuid
  code                 String                @db.VarChar(64)
  title                String                @db.VarChar(500)
  position             Int
  provenance           curriculum_provenance
  evidence_reference_id String?              @db.Uuid
  rationale            String?               @db.VarChar(1000)

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id], onDelete: Cascade)
  topics          topic[]

  @@unique([subject_version_id, code])
}

model topic {
  id                    String                @id @default(uuid()) @db.Uuid
  chapter_id            String                @db.Uuid
  code                  String                @db.VarChar(64)
  title                 String                @db.VarChar(500)
  position              Int
  provenance            curriculum_provenance
  evidence_reference_id String?               @db.Uuid
  rationale             String?               @db.VarChar(1000)

  chapter        chapter         @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  micro_concepts micro_concept[]

  @@unique([chapter_id, code])
}

model micro_concept {
  id                    String                @id @default(uuid()) @db.Uuid
  topic_id              String                @db.Uuid
  code                  String                @db.VarChar(64)
  title                 String                @db.VarChar(500)
  position              Int
  provenance            curriculum_provenance
  evidence_reference_id String?               @db.Uuid
  rationale             String?               @db.VarChar(1000)

  topic              topic                @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  learning_objectives learning_objective[]

  @@unique([topic_id, code])
}

model learning_objective {
  id                    String                @id @default(uuid()) @db.Uuid
  micro_concept_id      String                @db.Uuid
  code                  String                @db.VarChar(64)
  statement             String                @db.VarChar(1000)
  position              Int
  provenance            curriculum_provenance
  evidence_reference_id String?               @db.Uuid
  rationale             String?               @db.VarChar(1000)

  micro_concept micro_concept @relation(fields: [micro_concept_id], references: [id], onDelete: Cascade)

  @@unique([micro_concept_id, code])
}

/// Automated validation precedes human review. Results are append-only.
model curriculum_validation_run {
  id                 String                @id @default(uuid()) @db.Uuid
  subject_version_id String                @db.Uuid
  status             validation_run_status
  error_count        Int
  warning_count      Int
  created_at         DateTime              @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])
  results         curriculum_validation_result[]

  @@index([subject_version_id])
}

model curriculum_validation_result {
  id       String              @id @default(uuid()) @db.Uuid
  run_id   String              @db.Uuid
  severity validation_severity
  rule     String              @db.VarChar(64)
  path     String              @db.VarChar(500)
  message  String              @db.VarChar(1000)

  run curriculum_validation_run @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id])
}

model curriculum_approval_record {
  id                 String   @id @default(uuid()) @db.Uuid
  subject_version_id String   @db.Uuid
  decision           String   @db.VarChar(16)
  actor_account_id   String   @db.Uuid
  note               String?  @db.VarChar(1000)
  decided_at         DateTime @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])

  @@index([subject_version_id])
}

/// APPROVED is not ACTIVE: activation is its own human act, recorded here.
model curriculum_activation_record {
  id                 String   @id @default(uuid()) @db.Uuid
  subject_version_id String   @db.Uuid
  actor_account_id   String   @db.Uuid
  activated_at       DateTime @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])

  @@index([subject_version_id])
}

/// Append-only history of every transition and content replacement.
model curriculum_event_log {
  id                 String           @id @default(uuid()) @db.Uuid
  subject_version_id String           @db.Uuid
  event_type         String           @db.VarChar(64)
  from_state         curriculum_state?
  to_state           curriculum_state?
  actor_kind         String           @db.VarChar(16)
  actor_account_id   String?          @db.Uuid
  note               String?          @db.VarChar(1000)
  occurred_at        DateTime         @default(now())

  subject_version curriculum_subject_version @relation(fields: [subject_version_id], references: [id])

  @@index([subject_version_id, occurred_at])
}

// ---------------------------------------------------------------------------
// Block 008 — Question bank (multiple choice). A question belongs to a curriculum UNIT
// (curriculum version + grade + subject), not to one revision of it, and points at a learning
// objective by its codes ("chapter/topic/concept/objective"). A new curriculum revision is a new
// set of rows, so a foreign key to learning_objective would break on every correction.
// A question's wording is a REVISION; an approved revision is never edited.
// ---------------------------------------------------------------------------

enum question_state {
  DRAFT
  IN_REVIEW
  CHANGES_REQUIRED
  APPROVED
  RETIRED
  SUPERSEDED
  /// Pulled from serving after a defect or a live-performance signal. Kept as evidence; never assembled.
  QUARANTINED
}

/// Cognitive level C1 to C4 (spec: cognitive C1-C4). The meaning of each level is a curriculum decision, not stored here.
enum question_cognitive {
  C1
  C2
  C3
  C4
}

/// Only multiple choice is built. Other types arrive with their own runner and validation.
enum question_type {
  MCQ
}

enum question_difficulty {
  EASY
  MEDIUM
  HARD
}

enum question_origin {
  HUMAN
  AI_DRAFT
}

model question {
  id                    String   @id @default(uuid()) @db.Uuid
  curriculum_version_id String   @db.Uuid
  grade_id              String   @db.Uuid
  subject_id            String   @db.Uuid
  /// Unique within the unit, chosen by the author so a corrected file can update the same question.
  code                  String   @db.VarChar(64)
  /// "chapter_code/topic_code/concept_code/objective_code" in the unit's curriculum.
  objective_path        String   @db.VarChar(300)
  created_at            DateTime @default(now())

  revisions question_revision[]
  bank_state question_bank_state?

  @@unique([curriculum_version_id, grade_id, subject_id, code])
  @@index([curriculum_version_id, grade_id, subject_id])
}

model question_revision {
  id            String              @id @default(uuid()) @db.Uuid
  question_id   String              @db.Uuid
  revision      Int
  state         question_state      @default(DRAFT)
  origin        question_origin
  stem          String              @db.VarChar(2000)
  explanation   String?             @db.VarChar(2000)
  difficulty    question_difficulty
  /// Null on questions written before tagging existed. Required to submit a question for review.
  cognitive     question_cognitive?
  question_type question_type       @default(MCQ)
  /// SHA-256 of the normalised stem, to refuse the same question twice in a unit.
  stem_hash     String              @db.VarChar(64)
  /// Account ids are stored without a foreign key, as in curriculum governance. Null for the AI.
  authored_by   String?             @db.Uuid
  /// Everyone who wrote or edited the wording. None of them, nor the submitter, may approve it.
  contributor_ids String[]          @db.Uuid
  submitted_by  String?             @db.Uuid
  reviewed_by   String?             @db.Uuid
  review_note   String?             @db.VarChar(1000)
  /// The approver confirmed they checked the answer key themselves.
  answer_verified Boolean           @default(false)
  /// For AI drafts: who ran the import and the file hash.
  ai_source     String?             @db.VarChar(255)
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt

  question question          @relation(fields: [question_id], references: [id])
  options  question_option[]
  events   question_event[]
  validation_runs question_validation_run[]
  instance_items assessment_instance_question[]
  publication question_publication?

  @@unique([question_id, revision])
  @@index([state])
  @@index([stem_hash])
}

model question_option {
  id          String  @id @default(uuid()) @db.Uuid
  revision_id String  @db.Uuid
  position    Int
  text        String  @db.VarChar(500)
  is_correct  Boolean

  revision question_revision @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@unique([revision_id, position])
}

/// Append-only history of a revision's state changes.
model question_event {
  id          String          @id @default(uuid()) @db.Uuid
  revision_id String          @db.Uuid
  from_state  question_state?
  to_state    question_state
  actor_kind  String          @db.VarChar(16)
  actor_account_id String?    @db.Uuid
  note        String?         @db.VarChar(1000)
  /// Structured reason (registry in code). Required for sending back, retiring and quarantining.
  reason_code String?         @db.VarChar(32)
  occurred_at DateTime        @default(now())

  revision question_revision @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@index([revision_id])
}

// ---------------------------------------------------------------------------
// Block 009 — Assessment assembly and execution (Quick 10; TEST and PRACTICE).
// An INSTANCE is the exact, locked set of question revisions a student is given (never edited).
// A SESSION is the student's run through it. Responses are written once; their history is append-only.
// Every item references an exact question_revision (a "question version"), never a bare question.
// ---------------------------------------------------------------------------

enum assessment_mode {
  TEST
  PRACTICE
}

enum assessment_session_status {
  IN_PROGRESS
  SUBMITTED
  /// The resume window passed with no answer locked. There is no result. (Spec state EXPIRED_INCOMPLETE.)
  VOID
  /// Every question in it was excluded (technical failure or governed invalidation). It does not count. (Step 11)
  INVALIDATED
}

/// Why an item no longer counts (Step 11). Technical/item failure never counts as learner error (invariant 12).
enum assessment_item_exclusion {
  /// The system could not present or score the question properly.
  TECHNICAL_FAILURE
  /// An approver invalidated the question version after tests used it (InvalidateAssessmentItem).
  INVALIDATED
}

enum student_response_state {
  SKIPPED
  LOCKED
}

model assessment_instance {
  id                 String          @id @default(uuid()) @db.Uuid
  student_id         String          @db.Uuid
  mode               assessment_mode
  /// e.g. "QUICK10" and its version number, copied from the published blueprint version used (see assembly_run).
  blueprint_code     String          @db.VarChar(32)
  blueprint_version  Int
  curriculum_version_id String       @db.Uuid
  grade_id           String          @db.Uuid
  subject_id         String          @db.Uuid
  /// The exact curriculum_subject_version revision the questions were checked against.
  subject_version_id String          @db.Uuid
  /// Seed for the final tie-break and option order, so an assembly can be reproduced.
  seed               String          @db.VarChar(64)
  /// What assembly decided: counts per band, shortfalls filled, unseen count.
  assembly_report    Json
  assembled_at       DateTime        @default(now())

  student student                    @relation(fields: [student_id], references: [id])
  items   assessment_instance_question[]
  session assessment_session?
  /// How the instance was assembled from a published blueprint version (Step 10). Null on instances made before Step 10.
  assembly_run assessment_assembly_run?
  /// Step 14: the practice or retest recommendation this instance was built for, and the objectives it targeted.
  recommendation_id  String?         @db.Uuid
  target_objectives  String[]        @default([])
  recommendation     recommendation? @relation(fields: [recommendation_id], references: [id])

  @@index([student_id, assembled_at])
  @@index([recommendation_id])
}

model assessment_instance_question {
  id                   String              @id @default(uuid()) @db.Uuid
  instance_id          String              @db.Uuid
  /// 1-based order shown to the student.
  position             Int
  question_revision_id String              @db.Uuid
  question_id          String              @db.Uuid
  objective_path       String              @db.VarChar(300)
  difficulty           question_difficulty
  /// Permutation of the stored option positions (0..3, OPTION_POSITIONS): displayed slot i shows option_order[i].
  option_order         Int[]
  /// Set when the item stops counting: it is skipped in the flow and left out of the score.
  excluded             assessment_item_exclusion?
  excluded_at          DateTime?
  /// The governed invalidation that excluded it, when excluded = INVALIDATED.
  invalidation_id      String?             @db.Uuid

  instance     assessment_instance           @relation(fields: [instance_id], references: [id], onDelete: Cascade)
  revision     question_revision             @relation(fields: [question_revision_id], references: [id])
  response     student_response?
  invalidation assessment_item_invalidation? @relation(fields: [invalidation_id], references: [id])

  @@unique([instance_id, position])
  @@unique([instance_id, question_revision_id])
  @@index([question_revision_id])
}

model assessment_session {
  id               String                    @id @default(uuid()) @db.Uuid
  instance_id      String                    @unique @db.Uuid
  student_id       String                    @db.Uuid
  mode             assessment_mode
  status           assessment_session_status @default(IN_PROGRESS)
  started_at       DateTime                  @default(now())
  /// Resume window (about 24 hours at first).
  expires_at       DateTime
  last_activity_at DateTime                  @default(now())
  /// True once the student has used the one revisit of skipped questions.
  revisit_used     Boolean                   @default(false)
  /// First locked answer in a TEST commits the competitive attempt.
  committed_at     DateTime?
  submitted_at     DateTime?

  instance    assessment_instance     @relation(fields: [instance_id], references: [id])
  responses   student_response[]
  events      student_response_event[]
  submission  assessment_submission?
  result      assessment_result?

  @@index([student_id, status])
  @@index([status, expires_at])
}

model student_response {
  id                  String                 @id @default(uuid()) @db.Uuid
  session_id          String                 @db.Uuid
  instance_question_id String                @unique @db.Uuid
  /// Null while presented and not yet decided.
  state               student_response_state?
  /// How many times this question was skipped (1 = first pass; 2 = skipped again on the revisit).
  skip_count          Int                    @default(0)
  /// Displayed slot chosen (0..3) and the stored option position it maps to (1..4).
  selected_slot       Int?
  selected_position   Int?
  is_correct          Boolean?
  presented_at        DateTime?
  locked_at           DateTime?
  /// Client-reported active time, clamped on the server. The server also keeps its own elapsed time.
  active_ms           Int?
  server_elapsed_ms   Int?
  idempotency_key     String?                @db.VarChar(64)
  /// Request key of the latest skip, so a retried skip returns the same answer (Step 11).
  skip_idempotency_key String?               @db.VarChar(64)

  session  assessment_session          @relation(fields: [session_id], references: [id], onDelete: Cascade)
  question assessment_instance_question @relation(fields: [instance_question_id], references: [id], onDelete: Cascade)

  @@unique([session_id, idempotency_key])
}

/// Append-only: every present, skip and lock.
model student_response_event {
  id                   String   @id @default(uuid()) @db.Uuid
  session_id           String   @db.Uuid
  instance_question_id String   @db.Uuid
  event_type           String   @db.VarChar(24)
  active_ms            Int?
  occurred_at          DateTime @default(now())

  session assessment_session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, occurred_at])
}

model assessment_submission {
  id               String   @id @default(uuid()) @db.Uuid
  session_id       String   @unique @db.Uuid
  /// STUDENT, or EXPIRED when the resume window ended with at least one answer locked.
  reason           String   @db.VarChar(16)
  answered_count   Int
  unanswered_count Int
  submitted_at     DateTime @default(now())

  session assessment_session @relation(fields: [session_id], references: [id])
}

model assessment_result {
  id                   String   @id @default(uuid()) @db.Uuid
  session_id           String   @unique @db.Uuid
  student_id           String   @db.Uuid
  mode                 assessment_mode
  /// Scoring rule used, so a later rule never silently rescores this one.
  scoring_policy       String   @db.VarChar(32)
  total                Int
  correct              Int
  unanswered           Int
  by_difficulty        Json
  /// A TEST whose first answer was locked. Competitive points are a later block.
  competitive_eligible Boolean
  scored_at            DateTime @default(now())
  /// Set when an invalidation rescored this result; the history is in assessment_result_correction.
  corrected_at         DateTime?
  correction_count     Int      @default(0)

  session     assessment_session             @relation(fields: [session_id], references: [id])
  corrections assessment_result_correction[]

  @@index([student_id, scored_at])
}

/// Which questions a student has been shown, so assembly prefers ones they have not seen.
model student_question_exposure {
  id               String   @id @default(uuid()) @db.Uuid
  student_id       String   @db.Uuid
  question_id      String   @db.Uuid
  first_seen_at    DateTime @default(now())
  last_seen_at     DateTime @default(now())
  times_seen       Int      @default(1)

  student student @relation(fields: [student_id], references: [id])

  @@unique([student_id, question_id])
}

// ── 01b Guardian invitations (Block 010) ────────────────────────────────

enum guardian_invitation_status {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// A student's request that a named adult approve their account. The link token is
/// stored only as a SHA-256 hash. At most one PENDING row per student (the service
/// serialises on the student row; the migration adds a partial unique index as well).
model guardian_invitation {
  id                        String                     @id @default(uuid()) @db.Uuid
  student_id                String                     @db.Uuid
  invited_by_account_id     String                     @db.Uuid
  guardian_email_normalized String                     @db.VarChar(320)
  relationship_type         String                     @db.VarChar(50)
  token_hash                String                     @unique @db.VarChar(64)
  status                    guardian_invitation_status @default(PENDING)
  expires_at                DateTime
  created_at                DateTime                   @default(now())
  resolved_at               DateTime?
  accepted_by_account_id    String?                    @db.Uuid

  student student @relation(fields: [student_id], references: [id])

  @@index([student_id, created_at])
  @@index([guardian_email_normalized, created_at])
}

// ---------------------------------------------------------------------------
// Block 005 — School & Academic Plan (Domain 04), first cut: registry + student selection.
// Official curriculum != school academic plan. A student-selected association grants no
// school access. School plans (term/chapter mapping) are modelled further below.
// Coarse geography only (country, city) — never exact location.
// ---------------------------------------------------------------------------

enum school_registry_status {
  ACTIVE
  RETIRED
}

enum school_candidate_status {
  PENDING
  ACCEPTED
  REJECTED
}

enum school_association_state {
  UNVERIFIED
  STUDENT_SELECTED
  VERIFIED
  SCHOOL_CONFIRMED
}

model school {
  id           String                 @id @default(uuid()) @db.Uuid
  name         String                 @db.VarChar(200)
  country_code String                 @db.VarChar(2)
  city         String?                @db.VarChar(100)
  status       school_registry_status @default(ACTIVE)
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt

  aliases      school_alias[]
  branches     school_branch[]
  candidates   school_candidate[]
  associations student_school_association[]
  academic_plans school_academic_plan[]

  @@unique([country_code, name])
}

model school_alias {
  id        String @id @default(uuid()) @db.Uuid
  school_id String @db.Uuid
  alias     String @db.VarChar(200)

  school school @relation(fields: [school_id], references: [id])

  @@unique([school_id, alias])
}

model school_branch {
  id        String                 @id @default(uuid()) @db.Uuid
  school_id String                 @db.Uuid
  name      String                 @db.VarChar(200)
  city      String?                @db.VarChar(100)
  status    school_registry_status @default(ACTIVE)

  school       school                       @relation(fields: [school_id], references: [id])
  associations student_school_association[]

  @@unique([school_id, name])
}

/// A school name a student typed that is not in the registry. Never trusted; admin resolves it.
model school_candidate {
  id                  String                  @id @default(uuid()) @db.Uuid
  name_as_entered     String                  @db.VarChar(200)
  country_code        String                  @db.VarChar(2)
  status              school_candidate_status @default(PENDING)
  resolved_school_id  String?                 @db.Uuid
  resolved_by         String?                 @db.VarChar(255)
  resolved_at         DateTime?
  created_at          DateTime                @default(now())

  resolved_school school?                      @relation(fields: [resolved_school_id], references: [id])
  associations    student_school_association[]

  @@index([status])
}

/// Append-only history: changing or leaving a school ends the open row and (optionally) adds a new one.
/// Invariants enforced in code and by the migration: at most ONE open row per student
/// (partial unique index on student_id WHERE ended_at IS NULL), and exactly one of
/// school_id / candidate_id is set (CHECK).
model student_school_association {
  id           String                    @id @default(uuid()) @db.Uuid
  student_id   String                    @db.Uuid
  school_id    String?                   @db.Uuid
  branch_id    String?                   @db.Uuid
  candidate_id String?                   @db.Uuid
  state        school_association_state
  started_at   DateTime                  @default(now())
  ended_at     DateTime?
  end_reason   String?                   @db.VarChar(32)

  student   student           @relation(fields: [student_id], references: [id])
  school    school?           @relation(fields: [school_id], references: [id])
  branch    school_branch?    @relation(fields: [branch_id], references: [id])
  candidate school_candidate? @relation(fields: [candidate_id], references: [id])

  @@index([student_id, ended_at])
}

/// Which curriculum and grade the student studies. Launch cohort is enforced in code
/// (ICSE / GRADE_8); this is the student's own statement, not a verified fact.
model student_academic_context {
  id              String   @id @default(uuid()) @db.Uuid
  student_id      String   @unique @db.Uuid
  curriculum_code String   @db.VarChar(32)
  grade_code      String   @db.VarChar(16)
  updated_at      DateTime @updatedAt

  student student @relation(fields: [student_id], references: [id])
}

enum school_plan_status {
  DRAFT
  PUBLISHED
}

/// A school's own plan for one academic year, entered by an operator from what the school provided.
/// There is NO universal Term 1 / Term 2 mapping: term and assessment labels are the school's words,
/// and chapters are referenced by canonical chapter code (validated against the curriculum at entry).
model school_academic_plan {
  id              String             @id @default(uuid()) @db.Uuid
  school_id       String             @db.Uuid
  curriculum_code String             @db.VarChar(32)
  grade_code      String             @db.VarChar(16)
  academic_year   String             @db.VarChar(9)
  status          school_plan_status @default(DRAFT)
  created_by      String             @db.VarChar(255)
  created_at      DateTime           @default(now())
  published_at    DateTime?

  school  school             @relation(fields: [school_id], references: [id])
  entries school_plan_entry[]

  @@unique([school_id, curriculum_code, grade_code, academic_year])
}

model school_plan_entry {
  id               String @id @default(uuid()) @db.Uuid
  plan_id          String @db.Uuid
  term_label       String @db.VarChar(40)
  /// Empty string when the entry is for the term as a whole.
  assessment_label String @default("") @db.VarChar(60)
  subject_code     String @db.VarChar(64)
  chapter_code     String @db.VarChar(64)
  position         Int

  plan school_academic_plan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, term_label, assessment_label, subject_code, chapter_code])
}

/// The chapters a student chose to focus on. Their own choice; a school plan is only a suggestion.
model student_chapter_selection {
  id           String   @id @default(uuid()) @db.Uuid
  student_id   String   @db.Uuid
  subject_code String   @db.VarChar(64)
  chapter_code String   @db.VarChar(64)
  created_at   DateTime @default(now())

  student student @relation(fields: [student_id], references: [id])

  @@unique([student_id, subject_code, chapter_code])
}

/// One run of the deterministic checks against one exact revision. Append-only evidence.
model question_validation_run {
  id                String   @id @default(uuid()) @db.Uuid
  revision_id       String   @db.Uuid
  /// Version of the check set, so old runs stay interpretable when the checks change.
  validator_version String   @db.VarChar(32)
  passed            Boolean
  critical_count    Int
  major_count       Int
  minor_count       Int
  findings          Json
  created_at        DateTime @default(now())

  revision question_revision @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@index([revision_id, created_at])
}

// ---------------------------------------------------------------------------
// Step 8 — AI Question Factory. The AI only ever produces DRAFT questions through the normal question
// path; a person must submit and a different person approve. These tables are the evidence trail.
// ---------------------------------------------------------------------------

enum generation_batch_status {
  RUNNING
  STOP_REQUESTED
  COMPLETED
  STOPPED
}

enum generation_attempt_outcome {
  /// Stored as a DRAFT question for human review.
  DRAFT_STORED
  /// Failed the automatic structure checks.
  REJECTED_STRUCTURE
  /// The same wording already exists in the unit.
  REJECTED_DUPLICATE
  /// Validators raised a critical gate or the score was below the amber threshold.
  REJECTED_QUALITY
  /// A validator could not run or returned unusable output, so the candidate was not routed.
  FAILED_VALIDATION
  /// The generator itself failed or returned unusable output.
  FAILED_GENERATION
}

enum ai_call_status {
  OK
  INVALID_OUTPUT
  ERROR
}

/// One request to generate for one cell (objective x difficulty x cognitive). The operator decides demand.
model generation_batch {
  id                    String                  @id @default(uuid()) @db.Uuid
  curriculum_version_id String                  @db.Uuid
  grade_id              String                  @db.Uuid
  subject_id            String                  @db.Uuid
  objective_path        String                  @db.VarChar(300)
  difficulty            question_difficulty
  cognitive             question_cognitive
  requested_count       Int
  status                generation_batch_status @default(RUNNING)
  stop_reason           String?                 @db.VarChar(255)
  requested_by          String                  @db.VarChar(255)
  provider              String                  @db.VarChar(32)
  model                 String                  @db.VarChar(100)
  config_version        String                  @db.VarChar(32)
  drafts_stored         Int                     @default(0)
  rejected              Int                     @default(0)
  duplicates            Int                     @default(0)
  failed                Int                     @default(0)
  started_at            DateTime                @default(now())
  finished_at           DateTime?

  attempts generation_attempt[]
  calls    ai_call_log[]

  @@index([curriculum_version_id, grade_id, subject_id, objective_path, started_at])
}

model generation_attempt {
  id                   String                     @id @default(uuid()) @db.Uuid
  batch_id             String                     @db.Uuid
  sequence             Int
  outcome              generation_attempt_outcome
  /// GREEN / YELLOW / AMBER / RED, or null when the candidate was never routed.
  route                String?                    @db.VarChar(8)
  confidence           Float?
  repairs              Int                        @default(0)
  /// The exact candidate, kept even when rejected, so a rejection can be audited.
  candidate            Json?
  /// Validator scores, gates and issues behind the route.
  evidence             Json?
  question_revision_id String?                    @db.Uuid
  note                 String?                    @db.VarChar(500)
  created_at           DateTime                   @default(now())

  batch generation_batch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@unique([batch_id, sequence])
  @@index([question_revision_id])
}

/// Every call to a model, whatever the role. Hashes, not content: the candidate content is on the attempt.
model ai_call_log {
  id             String         @id @default(uuid()) @db.Uuid
  batch_id       String         @db.Uuid
  attempt_seq    Int?
  role           String         @db.VarChar(40)
  provider       String         @db.VarChar(32)
  model          String         @db.VarChar(100)
  prompt_version String         @db.VarChar(16)
  schema_version String         @db.VarChar(16)
  input_hash     String         @db.VarChar(64)
  output_hash    String?        @db.VarChar(64)
  latency_ms     Int
  status         ai_call_status
  detail         String?        @db.VarChar(300)
  tokens_in      Int?
  tokens_out     Int?
  created_at     DateTime       @default(now())

  batch generation_batch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([batch_id])
  @@index([created_at])
}


// ============================================================================
// Step 9: Question bank and publication. Approved is not published (spec invariant 7).
// ============================================================================

enum publication_state {
  PUBLISHED
  WITHDRAWN
}

enum publication_action {
  PUBLISH
  WITHDRAW
}

/// Stored health of a published question. Quarantined and retired are read from the revision's state, not stored here.
enum bank_health {
  NEW
  HEALTHY
  WATCH
  DEGRADED
}

/// One row per revision. Only a PUBLISHED row on an APPROVED revision can be served. A person publishes; the AI never does.
model question_publication {
  id                   String            @id @default(uuid()) @db.Uuid
  revision_id          String            @unique @db.Uuid
  state                publication_state
  published_by         String            @db.Uuid
  published_at         DateTime          @default(now())
  withdrawn_by         String?           @db.Uuid
  withdrawn_at         DateTime?
  withdraw_reason_code String?           @db.VarChar(40)
  withdraw_note        String?           @db.VarChar(1000)

  revision question_revision @relation(fields: [revision_id], references: [id])

  @@index([state])
}

/// Append-only history of publishing and withdrawing. A system withdrawal (quarantine, retire) has no account.
model question_publication_event {
  id         String             @id @default(uuid()) @db.Uuid
  revision_id String            @db.Uuid
  action     publication_action
  actor_kind String             @db.VarChar(8)
  actor_account_id String?      @db.Uuid
  reason_code String?           @db.VarChar(40)
  note       String?            @db.VarChar(1000)
  occurred_at DateTime          @default(now())

  @@index([revision_id])
}

/// Health of a question across its revisions. No row means NEW. Set by a person until live-quality signals exist.
model question_bank_state {
  question_id String      @id @db.Uuid
  health      bank_health
  changed_by  String?     @db.Uuid
  reason_code String?     @db.VarChar(40)
  note        String?     @db.VarChar(1000)
  updated_at  DateTime    @updatedAt

  question question @relation(fields: [question_id], references: [id])
}

// ---------------------------------------------------------------------------
// Step 10 — Assessment blueprints and assembly. Blueprint != Instance: a blueprint version is the design
// (how many questions, what mix, what scope); an instance is one student's locked test built from it.
// A published version is never edited; a change is a new version. Every assembly is recorded with one
// decision per question and the list of anything that had to be relaxed.
// ---------------------------------------------------------------------------

enum blueprint_version_status {
  DRAFT
  PUBLISHED
  RETIRED
}

enum blueprint_scope_mode {
  /// Every chapter of the subject.
  WHOLE_SUBJECT
  /// Only the chapters listed in blueprint_scope. The blueprint must be bound to one subject.
  CHAPTERS
  /// The chapters the student chose to focus on (Step 5).
  STUDENT_FOCUS
  /// Step 14: the learning objectives a practice or retest recommendation targets. Never offered as an ordinary test.
  OBJECTIVES
}

model assessment_blueprint {
  id              String   @id @default(uuid()) @db.Uuid
  /// Stable name used in code and on instances, e.g. QUICK10.
  code            String   @unique @db.VarChar(32)
  name            String   @db.VarChar(120)
  description     String?  @db.VarChar(1000)
  /// Off: no student is given this test, even with a published version. Previews still work.
  enabled         Boolean  @default(false)
  /// All three null = usable for any subject. All three set = only that subject; required for chapter scope or chapter cells.
  curriculum_code String?  @db.VarChar(32)
  grade_code      String?  @db.VarChar(16)
  subject_code    String?  @db.VarChar(64)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  versions assessment_blueprint_version[]
}

/// One version of a blueprint. At most one PUBLISHED and one DRAFT per blueprint (partial unique indexes in the migration).
model assessment_blueprint_version {
  id                 String                   @id @default(uuid()) @db.Uuid
  blueprint_id       String                   @db.Uuid
  version            Int
  status             blueprint_version_status @default(DRAFT)
  total_questions    Int
  scope_mode         blueprint_scope_mode     @default(WHOLE_SUBJECT)
  /// Strict: never go outside the scope; too few questions means no test. Not strict: widen and record it.
  scope_strict       Boolean                  @default(false)
  /// Rank questions the student has not seen above ones they have.
  prefer_unseen      Boolean                  @default(true)
  /// Put a question of this difficulty first, when the test has one.
  opening_difficulty question_difficulty?
  notes              String?                  @db.VarChar(1000)
  created_by         String?                  @db.Uuid
  created_at         DateTime                 @default(now())
  published_by       String?                  @db.Uuid
  published_at       DateTime?
  retired_at         DateTime?

  blueprint    assessment_blueprint               @relation(fields: [blueprint_id], references: [id])
  scopes       blueprint_scope[]
  difficulties blueprint_difficulty_requirement[]
  types        blueprint_type_requirement[]
  cells        blueprint_cell_requirement[]
  runs         assessment_assembly_run[]

  @@unique([blueprint_id, version])
}

/// Chapters in scope for a CHAPTERS blueprint version (chapter codes of the bound subject).
model blueprint_scope {
  id           String @id @default(uuid()) @db.Uuid
  version_id   String @db.Uuid
  chapter_code String @db.VarChar(64)

  version assessment_blueprint_version @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@unique([version_id, chapter_code])
}

/// How many questions of each difficulty. The counts add up to total_questions.
model blueprint_difficulty_requirement {
  id         String              @id @default(uuid()) @db.Uuid
  version_id String              @db.Uuid
  difficulty question_difficulty
  count      Int

  version assessment_blueprint_version @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@unique([version_id, difficulty])
}

/// How many questions of each type. The counts add up to total_questions. Only MCQ exists today.
model blueprint_type_requirement {
  id            String        @id @default(uuid()) @db.Uuid
  version_id    String        @db.Uuid
  question_type question_type
  count         Int

  version assessment_blueprint_version @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@unique([version_id, question_type])
}

/// "At least min_count questions matching this cell". A null field matches anything; at least one field is set.
model blueprint_cell_requirement {
  id           String               @id @default(uuid()) @db.Uuid
  version_id   String               @db.Uuid
  position     Int
  chapter_code String?              @db.VarChar(64)
  difficulty   question_difficulty?
  cognitive    question_cognitive?
  min_count    Int

  version assessment_blueprint_version @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@unique([version_id, position])
}

/// One assembly that produced an instance. Read-only previews are not stored.
model assessment_assembly_run {
  id                   String          @id @default(uuid()) @db.Uuid
  instance_id          String          @unique @db.Uuid
  blueprint_version_id String          @db.Uuid
  /// Version of the assembly rules, so an old run stays interpretable when the rules change.
  engine_version       String          @db.VarChar(32)
  seed                 String          @db.VarChar(64)
  mode                 assessment_mode
  /// Questions that could be used after removing duplicates, wrong types and (strict) out-of-scope ones.
  eligible_count       Int
  requested            Json
  delivered            Json
  /// Every place the design could not be met exactly: difficulty substitutions, unmet cells, widened scope, seen questions used.
  relaxations          Json
  relaxed              Boolean
  created_at           DateTime        @default(now())

  instance          assessment_instance            @relation(fields: [instance_id], references: [id], onDelete: Cascade)
  blueprint_version assessment_blueprint_version   @relation(fields: [blueprint_version_id], references: [id])
  decisions         assessment_assembly_decision[]

  @@index([blueprint_version_id, created_at])
}

/// Why each question in an instance was chosen.
model assessment_assembly_decision {
  id                   String               @id @default(uuid()) @db.Uuid
  run_id               String               @db.Uuid
  /// Position in the instance (1-based).
  position             Int
  question_revision_id String               @db.Uuid
  question_id          String               @db.Uuid
  /// CELL (to meet a minimum), DIFFICULTY (normal mix) or SUBSTITUTE (a short difficulty filled from the nearest one).
  requirement          String               @db.VarChar(16)
  cell_position        Int?
  wanted_difficulty    question_difficulty
  difficulty           question_difficulty
  /// e.g. UNSEEN, NEW_CHAPTER, NEW_OBJECTIVE, NEW_COGNITIVE, OUT_OF_SCOPE, HEALTH_WATCH, TIE_BREAK_RANDOM.
  reasons              String[]
  /// How many questions were eligible for this slot.
  candidates           Int

  run assessment_assembly_run @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@unique([run_id, position])
}

// ---------------------------------------------------------------------------
// Step 11 — Assessment execution: governed invalidation of items already used in tests.
// ---------------------------------------------------------------------------

/// One InvalidateAssessmentItem decision: a question version stops counting in every test that used it.
model assessment_item_invalidation {
  id                   String   @id @default(uuid()) @db.Uuid
  /// One decision per version; repeating it changes nothing.
  question_revision_id String   @unique @db.Uuid
  reason_code          String   @db.VarChar(40)
  note                 String   @db.VarChar(1000)
  invalidated_by       String   @db.Uuid
  created_at           DateTime @default(now())
  items_affected       Int
  results_rescored     Int
  sessions_invalidated Int

  items       assessment_instance_question[]
  corrections assessment_result_correction[]
}

/// Append-only history of every change to a result after it was first scored. The result row holds the current value.
model assessment_result_correction {
  id              String   @id @default(uuid()) @db.Uuid
  result_id       String   @db.Uuid
  session_id      String   @db.Uuid
  invalidation_id String?  @db.Uuid
  /// INVALIDATION today.
  reason          String   @db.VarChar(32)
  /// total / correct / unanswered / by_difficulty / competitive_eligible before and after.
  before          Json
  after           Json
  created_at      DateTime @default(now())

  result       assessment_result             @relation(fields: [result_id], references: [id], onDelete: Cascade)
  invalidation assessment_item_invalidation? @relation(fields: [invalidation_id], references: [id])

  @@index([session_id, created_at])
}

// ---------------------------------------------------------------------------
// Step 13 — Mastery & diagnostics. Primary unit = learning objective. Score != mastery; mastery != confidence;
// unknown != zero. Evidence is immutable and weighted; state is recomputed from all valid evidence under a versioned
// policy. AI never writes any of this.
// ---------------------------------------------------------------------------

/// The rules and numbers mastery is computed with. Exactly one ACTIVE (partial unique index in the migration).
model mastery_policy_version {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(32)
  /// ACTIVE or RETIRED.
  status     String   @db.VarChar(16)
  /// Weights, prior, confidence formula parameters, gates and bands. See mastery-domain.ts for the shape.
  params     Json
  notes      String?  @db.VarChar(1000)
  created_at DateTime @default(now())

  evidence mastery_evidence_event[]
  runs     mastery_update_run[]
}

/// One piece of evidence: a locked answer to one question version, attributed to one learning objective. Never edited;
/// an invalidated item sets invalidated_at and the state is recomputed without it.
model mastery_evidence_event {
  id                    String   @id @default(uuid()) @db.Uuid
  student_id            String   @db.Uuid
  /// Stable objective key within the curriculum version, grade and subject: "chapter/topic/concept/objective".
  curriculum_version_id String   @db.Uuid
  grade_id              String   @db.Uuid
  subject_id            String   @db.Uuid
  objective_path        String   @db.VarChar(300)
  /// The learning_objective row of the exact curriculum revision the test was built against (traceability only).
  learning_objective_id String?  @db.Uuid
  subject_version_id    String   @db.Uuid
  session_id            String   @db.Uuid
  instance_question_id  String   @db.Uuid
  question_id           String   @db.Uuid
  question_revision_id  String   @db.Uuid
  mode                  assessment_mode
  blueprint_code        String   @db.VarChar(32)
  /// 1 correct, 0 incorrect.
  score                 Float
  difficulty            question_difficulty
  cognitive             question_cognitive?
  /// The factors and their product (capped). Kept so any state can be explained.
  w_independence        Float
  w_context             Float
  w_quality             Float
  weight                Float
  policy_version_id     String   @db.Uuid
  answered_at           DateTime
  created_at            DateTime @default(now())
  invalidated_at        DateTime?
  invalidation_reason   String?  @db.VarChar(32)

  policy mastery_policy_version @relation(fields: [policy_version_id], references: [id])

  @@unique([session_id, instance_question_id])
  @@index([student_id, curriculum_version_id, grade_id, subject_id, objective_path])
  @@index([student_id, question_id])
}

/// The current state of one learning objective for one student, recomputed from all valid evidence.
model student_mastery_state {
  id                    String   @id @default(uuid()) @db.Uuid
  student_id            String   @db.Uuid
  curriculum_version_id String   @db.Uuid
  grade_id              String   @db.Uuid
  subject_id            String   @db.Uuid
  objective_path        String   @db.VarChar(300)
  policy_version_id     String   @db.Uuid
  alpha                 Float
  beta                  Float
  /// alpha / (alpha + beta), 0..1.
  mastery               Float
  /// 0..100.
  confidence            Float
  effective_evidence    Float
  evidence_count        Int
  families              Int
  sessions              Int
  controlled_evidence   Int
  /// NOT_STARTED, BUILDING_EVIDENCE, NEEDS_ATTENTION, DEVELOPING, SECURE, STRONG.
  label                 String   @db.VarChar(24)
  reportable            Boolean
  last_evidence_at      DateTime?
  updated_at            DateTime @updatedAt

  @@unique([student_id, curriculum_version_id, grade_id, subject_id, objective_path])
  @@index([student_id, subject_id])
}

/// One processing of one finished (or rescored, or invalidated) test. Unique per result revision, so a retry or a
/// second worker never adds evidence twice.
model mastery_update_run {
  id                String   @id @default(uuid()) @db.Uuid
  session_id        String   @db.Uuid
  /// assessment_result.correction_count at processing time; -1 when the session was INVALIDATED.
  result_revision   Int
  student_id        String   @db.Uuid
  policy_version_id String   @db.Uuid
  evidence_added    Int
  evidence_invalidated Int
  objectives_changed Int
  created_at        DateTime @default(now())

  policy  mastery_policy_version @relation(fields: [policy_version_id], references: [id])
  changes mastery_state_change[]
  /// Step 14: the recommendation refresh this run triggered (none yet = the reconciler will pick it up).
  recommendation_refresh recommendation_refresh?

  @@unique([session_id, result_revision])
  @@index([student_id, created_at])
}

/// Before and after for every objective a run changed: the trajectory, and the audit of what moved and why.
model mastery_state_change {
  id             String   @id @default(uuid()) @db.Uuid
  run_id         String   @db.Uuid
  student_id     String   @db.Uuid
  objective_path String   @db.VarChar(300)
  subject_id     String   @db.Uuid
  before_label   String?  @db.VarChar(24)
  after_label    String   @db.VarChar(24)
  before_mastery Float?
  after_mastery  Float
  before_confidence Float?
  after_confidence Float
  created_at     DateTime @default(now())

  run mastery_update_run @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([student_id, objective_path, created_at])
}

/// Per student, subject and difficulty: how they do on easy / medium / hard questions (same accumulator, same weights).
model student_difficulty_state {
  id                 String              @id @default(uuid()) @db.Uuid
  student_id         String              @db.Uuid
  subject_id         String              @db.Uuid
  difficulty         question_difficulty
  mastery            Float
  effective_evidence Float
  evidence_count     Int
  updated_at         DateTime            @updatedAt

  @@unique([student_id, subject_id, difficulty])
}

/// Per student, subject and cognitive level (C1-C4; untagged questions are left out).
model student_cognitive_state {
  id                 String             @id @default(uuid()) @db.Uuid
  student_id         String             @db.Uuid
  subject_id         String             @db.Uuid
  cognitive          question_cognitive
  mastery            Float
  effective_evidence Float
  evidence_count     Int
  updated_at         DateTime           @updatedAt

  @@unique([student_id, subject_id, cognitive])
}

// ── Step 14: recommendations, practice and retest ─────────────────────────

/// The rules that choose practice and retest recommendations. Exactly one ACTIVE (partial unique index in the migration).
model recommendation_policy_version {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(32)
  /// ACTIVE or RETIRED.
  status     String   @db.VarChar(16)
  /// See recommendation-domain.ts for the shape.
  params     Json
  notes      String?  @db.VarChar(1000)
  created_at DateTime @default(now())

  recommendations recommendation[]
  refreshes       recommendation_refresh[]
}

enum recommendation_kind {
  /// A PRACTICE set (answers shown after each lock; evidence discounted).
  PRACTICE
  /// A short TEST on the same objectives after practice (independent retest).
  RETEST
}

enum recommendation_status {
  OPEN
  /// A practice or retest was started from it.
  STARTED
  COMPLETED
  /// The student said "not now".
  DISMISSED
  /// Replaced by a newer recommendation before it was started.
  SUPERSEDED
}

enum recommendation_source {
  /// Chosen from mastery states after a mastery run.
  MASTERY
  /// "Practise what you missed" from a finished test.
  RESULT
  /// A retest offered because the practice it follows was finished.
  PRACTICE_DONE
}

/// One recommendation for one student and subject. At most one OPEN or STARTED per student and subject (partial
/// unique index). Every recommendation keeps its reasons, the policy that chose it and what it was chosen from.
model recommendation {
  id                    String                @id @default(uuid()) @db.Uuid
  student_id            String                @db.Uuid
  curriculum_version_id String                @db.Uuid
  grade_id              String                @db.Uuid
  subject_id            String                @db.Uuid
  kind                  recommendation_kind
  status                recommendation_status @default(OPEN)
  source                recommendation_source
  objective_paths       String[]
  policy_version_id     String                @db.Uuid
  /// MASTERY and PRACTICE_DONE: the mastery run whose refresh chose it.
  source_run_id         String?               @db.Uuid
  /// RESULT: the finished test whose missed questions it targets.
  source_assessment_id  String?               @db.Uuid
  /// RETEST: the practice recommendation it follows.
  parent_id             String?               @db.Uuid
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  closed_at             DateTime?

  policy    recommendation_policy_version @relation(fields: [policy_version_id], references: [id])
  parent    recommendation?               @relation("retest_of", fields: [parent_id], references: [id])
  retests   recommendation[]              @relation("retest_of")
  reasons   recommendation_reason[]
  events    recommendation_event[]
  instances assessment_instance[]

  @@index([student_id, status])
  @@index([student_id, subject_id, created_at])
}

/// Why a recommendation targets an objective: a code and the facts behind it (label, mastery, answers, the test).
model recommendation_reason {
  id                String   @id @default(uuid()) @db.Uuid
  recommendation_id String   @db.Uuid
  objective_path    String   @db.VarChar(300)
  /// NEEDS_ATTENTION, DEVELOPING, MISSED_MORE_THAN_RIGHT, MISSED_IN_TEST, PRACTISED.
  code              String   @db.VarChar(32)
  facts             Json

  recommendation recommendation @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)

  @@index([recommendation_id])
}

/// What happened to a recommendation: CREATED, STARTED, COMPLETED, REOPENED, DISMISSED, SUPERSEDED.
model recommendation_event {
  id                String   @id @default(uuid()) @db.Uuid
  recommendation_id String   @db.Uuid
  type              String   @db.VarChar(16)
  assessment_id     String?  @db.Uuid
  at                DateTime @default(now())

  recommendation recommendation @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)

  @@index([recommendation_id, at])
}

/// One refresh of a student's recommendations after one mastery run. Unique per run, so a retry or a second worker
/// never acts twice on the same evidence.
model recommendation_refresh {
  id                String   @id @default(uuid()) @db.Uuid
  mastery_run_id    String   @unique @db.Uuid
  student_id        String   @db.Uuid
  policy_version_id String   @db.Uuid
  /// What the refresh did: created, completed, reopened, superseded ids.
  outcome           Json
  created_at        DateTime @default(now())

  run    mastery_update_run            @relation(fields: [mastery_run_id], references: [id], onDelete: Cascade)
  policy recommendation_policy_version @relation(fields: [policy_version_id], references: [id])

  @@index([student_id, created_at])
}

// ── Step 15: competitive points, XP and leaderboards ──────────────────────

/// The rules for CP, XP and ranking. Exactly one ACTIVE (partial unique index in the migration).
model competitive_scoring_policy {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(32)
  /// ACTIVE or RETIRED.
  status     String   @db.VarChar(16)
  /// See competition-domain.ts for the shape.
  params     Json
  notes      String?  @db.VarChar(1000)
  created_at DateTime @default(now())

  qualifications competitive_qualification[]
  cp_events      cp_event[]
  xp_events      xp_event[]
}

/// Whether one result revision of one finished test counts competitively, why, and the CP it earns. One row per
/// (session, result revision); -1 is the revision of an invalidated test. The latest row is the current one.
model competitive_qualification {
  id                    String   @id @default(uuid()) @db.Uuid
  session_id            String   @db.Uuid
  result_revision       Int
  student_id            String   @db.Uuid
  policy_version_id     String   @db.Uuid
  curriculum_version_id String   @db.Uuid
  grade_id              String   @db.Uuid
  subject_id            String   @db.Uuid
  blueprint_code        String   @db.VarChar(32)
  qualified             Boolean
  /// Why not: NOT_A_TEST, NOT_COMPETITIVE_DESIGN, NOT_COMMITTED, INVALIDATED, TOO_FEW_QUESTIONS.
  reasons               String[]
  eligible_questions    Int
  fresh_questions       Int
  correct               Int
  accuracy              Float
  weighted_accuracy     Float
  difficulty_score      Float
  cp                    Int
  /// The parts of the CP: base, accuracy and improvement.
  parts                 Json
  /// When the test was finished: decides its week, also for later corrections.
  finished_at           DateTime
  created_at            DateTime @default(now())

  policy    competitive_scoring_policy @relation(fields: [policy_version_id], references: [id])
  cp_events cp_event[]

  @@unique([session_id, result_revision])
  @@index([student_id, finished_at])
  @@index([curriculum_version_id, grade_id, finished_at])
}

enum cp_event_kind {
  AWARD
  /// A correction after a rescore (positive or negative).
  ADJUSTMENT
  /// The test no longer earns anything (invalidated): the rest is taken back.
  REVERSAL
}

/// The CP ledger. Append-only: a database trigger refuses UPDATE and DELETE; corrections are compensating entries
/// dated to the week the test was finished, so a past week's board is corrected in place.
model cp_event {
  id                    String        @id @default(uuid()) @db.Uuid
  student_id            String        @db.Uuid
  session_id            String        @db.Uuid
  qualification_id      String        @db.Uuid
  policy_version_id     String        @db.Uuid
  curriculum_version_id String        @db.Uuid
  grade_id              String        @db.Uuid
  subject_id            String        @db.Uuid
  kind                  cp_event_kind
  amount                Int
  /// The finish time of the test it is for (decides the leaderboard week).
  earned_at             DateTime
  created_at            DateTime      @default(now())

  qualification competitive_qualification  @relation(fields: [qualification_id], references: [id])
  policy        competitive_scoring_policy @relation(fields: [policy_version_id], references: [id])

  @@index([student_id, earned_at])
  @@index([curriculum_version_id, grade_id, earned_at])
}

/// XP for taking part (tests and practice). One per finished session; never reversed.
model xp_event {
  id                String   @id @default(uuid()) @db.Uuid
  student_id        String   @db.Uuid
  session_id        String   @unique @db.Uuid
  policy_version_id String   @db.Uuid
  amount            Int
  /// TEST or PRACTICE.
  mode              String   @db.VarChar(16)
  earned_at         DateTime
  created_at        DateTime @default(now())

  policy competitive_scoring_policy @relation(fields: [policy_version_id], references: [id])

  @@index([student_id, earned_at])
}

/// How a student appears to other students: a neutral handle only, never a name, school or place. Minors are not
/// shown to others at all in Release 1 (spec: minor default Friends Only; friends come in Step 16). An adult may
/// choose to be hidden (shown_to_others = false); null means the default for their age.
model public_profile {
  student_id      String   @id @db.Uuid
  handle          String   @unique @db.VarChar(24)
  shown_to_others Boolean?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// ── Step 16: friends and ranked challenges (feature-flagged, off by default) ──

/// A one-time code a student shows another in person to become friends. Expires in minutes; single use.
model friend_code {
  id                 String    @id @default(uuid()) @db.Uuid
  student_id         String    @db.Uuid
  code               String    @unique @db.VarChar(12)
  created_at         DateTime  @default(now())
  expires_at         DateTime
  used_at            DateTime?
  used_by_student_id String?   @db.Uuid

  @@index([student_id, created_at])
}

/// Every code entered, right or wrong: wrong ones are rate-limited against guessing.
model friend_code_attempt {
  id         String   @id @default(uuid()) @db.Uuid
  student_id String   @db.Uuid
  ok         Boolean
  at         DateTime @default(now())

  @@index([student_id, at])
}

enum friendship_status {
  /// Waiting for the guardian of each minor in the pair.
  PENDING_GUARDIAN
  ACTIVE
  ENDED
}

/// One friendship per pair (student_low < student_high). At most one not ENDED per pair (partial unique index).
model friendship {
  id                  String            @id @default(uuid()) @db.Uuid
  student_low         String            @db.Uuid
  student_high        String            @db.Uuid
  status              friendship_status
  code_id             String?           @db.Uuid
  created_at          DateTime          @default(now())
  activated_at        DateTime?
  ended_at            DateTime?
  /// UNFRIENDED, BLOCKED, REPORTED, GUARDIAN_DECLINED.
  ended_reason        String?           @db.VarChar(24)
  ended_by_student_id String?           @db.Uuid

  approvals friendship_guardian_approval[]

  @@index([student_low])
  @@index([student_high])
}

/// A minor's guardian approving (or declining) one friendship. One row per minor in the pair.
model friendship_guardian_approval {
  id                    String    @id @default(uuid()) @db.Uuid
  friendship_id         String    @db.Uuid
  student_id            String    @db.Uuid
  /// PENDING, APPROVED, DECLINED.
  status                String    @db.VarChar(16)
  decided_by_account_id String?   @db.Uuid
  decided_at            DateTime?
  created_at            DateTime  @default(now())

  friendship friendship @relation(fields: [friendship_id], references: [id], onDelete: Cascade)

  @@unique([friendship_id, student_id])
  @@index([student_id, status])
}

/// A block. Takes effect both ways for friendship and challenges; only the blocker can lift it.
model student_block {
  id                 String   @id @default(uuid()) @db.Uuid
  blocker_student_id String   @db.Uuid
  blocked_student_id String   @db.Uuid
  created_at         DateTime @default(now())

  @@unique([blocker_student_id, blocked_student_id])
  @@index([blocked_student_id])
}

/// A report about another student. A reason code only (no free text). Ends any friendship at once; an admin reviews it.
model safety_report {
  id                     String    @id @default(uuid()) @db.Uuid
  reporter_student_id    String    @db.Uuid
  reported_student_id    String    @db.Uuid
  /// UNWANTED_CONTACT, CHALLENGE_SPAM, SUSPECTED_CHEATING, MADE_ME_UNCOMFORTABLE, OTHER.
  reason                 String    @db.VarChar(32)
  friendship_id          String?   @db.Uuid
  challenge_id           String?   @db.Uuid
  /// OPEN or RESOLVED.
  status                 String    @db.VarChar(16)
  /// NO_ACTION or RESTRICTED.
  resolution             String?   @db.VarChar(16)
  resolved_by_account_id String?   @db.Uuid
  resolved_at            DateTime?
  created_at             DateTime  @default(now())

  @@index([status, created_at])
  @@index([reported_student_id])
}

/// An admin's restriction: the student may not use friends or challenges until it is lifted.
model social_restriction {
  id                    String    @id @default(uuid()) @db.Uuid
  student_id            String    @db.Uuid
  report_id             String?   @db.Uuid
  created_by_account_id String    @db.Uuid
  created_at            DateTime  @default(now())
  lifted_at             DateTime?

  @@index([student_id])
}

enum challenge_status {
  /// Sent; the opponent has not accepted yet.
  PENDING
  /// Accepted: both may take it.
  ACTIVE
  DECLINED
  EXPIRED
  /// Both finished.
  COMPLETED
  /// Ended by a block, report or restriction.
  CANCELLED
}

/// A ranked challenge between two friends: the same ten questions for both, unseen by either when it was made.
model challenge {
  id                    String           @id @default(uuid()) @db.Uuid
  challenger_student_id String           @db.Uuid
  opponent_student_id   String           @db.Uuid
  friendship_id         String           @db.Uuid
  curriculum_version_id String           @db.Uuid
  grade_id              String           @db.Uuid
  subject_id            String           @db.Uuid
  subject_version_id    String           @db.Uuid
  status                challenge_status
  /// The question set, exactly as both players get it (revision, question, objective, difficulty, position, option order).
  items                 Json
  /// How it was assembled (seed, mix, relaxations).
  assembly_report       Json
  created_at            DateTime         @default(now())
  expires_at            DateTime
  responded_at          DateTime?
  completed_at          DateTime?

  participants challenge_participant[]

  @@index([challenger_student_id, created_at])
  @@index([opponent_student_id, status])
}

/// A player in a challenge and the test they take (created when they start).
model challenge_participant {
  id           String  @id @default(uuid()) @db.Uuid
  challenge_id String  @db.Uuid
  student_id   String  @db.Uuid
  /// CHALLENGER or OPPONENT.
  role         String  @db.VarChar(12)
  session_id   String? @unique @db.Uuid

  challenge challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, student_id])
}
