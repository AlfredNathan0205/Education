# PostgreSQL
DATABASE_URL=postgresql://exam_app:exam_app_dev@localhost:5432/exam_app

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
API_PORT=3001

# Identity (CONSTRUCTION-002)
# HMAC key for OTP hashing. Required (>= 32 chars) when requesting/verifying codes.
# Generate one with: openssl rand -hex 32
OTP_HMAC_SECRET=

# Sign-in code delivery (CONSTRUCTION-007).
#   EMAIL_PROVIDER=console  writes codes to the API log. Development only; the API refuses to start with it in production.
#   EMAIL_PROVIDER=resend   emails codes via Resend. Needs both values below. EMAIL_FROM must be on a domain
#                           verified in Resend (a Resend test address can only send to the account owner).
# Unset: console outside production, resend in production.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Dev-only: allow the seed-dev-policy command to create a test jurisdiction policy.
# Never set in production. See README "Seed a test jurisdiction policy".
ALLOW_DEV_TEST_POLICY=true

# Override the jurisdiction used for student age classification. Defaults to AE.
# Set to XX when using the dev test policy.
DEFAULT_JURISDICTION=XX

# Tests (CONSTRUCTION-009). In production only APPROVED questions from an ACTIVE curriculum are served.
#   EXAM_ALLOW_UNACTIVATED_CURRICULUM=true  lets local testing use an unactivated curriculum. The API refuses to start with it in production.
#   EXAM_RESUME_HOURS  how long a started test can be resumed (1 to 168, default 24).
EXAM_ALLOW_UNACTIVATED_CURRICULUM=false
EXAM_RESUME_HOURS=24

# Guardian approval (CONSTRUCTION-010). The approval link in the email starts with this address.
# Required, and must be https, in production. Uses the same EMAIL_PROVIDER settings as sign-in codes.
WEB_BASE_URL=http://localhost:3000

# Web app: where the Next.js server reaches the API (server-side only)
API_URL=http://localhost:3001
